# --- Postgres / Supabase database ---
# Use Supabase's Supavisor pooler (session mode, port 5432), NOT the "direct"
# db.<ref>.supabase.co:5432 host. The direct host is IPv6-only unless you've
# paid for Supabase's IPv4 add-on, and most PaaS platforms (Render, Vercel,
# GitHub Actions, Retool) have no IPv6 egress — a direct-host DATABASE_URL
# will build fine and then crash on startup with "OSError: Network is
# unreachable" the moment asyncpg tries to connect. Ask this the hard way
# once; don't repeat it.
#
# Get the exact pooler hostname from Supabase Dashboard -> your project ->
# "Connect" (button near the top) -> Session pooler. It is NOT a predictable
# aws-<N>-<region>.pooler.supabase.com pattern -- the <N> varies per project
# (we've seen both aws-0- and aws-1- for otherwise-identical eu-west-2
# projects) and guessing it wastes a deploy cycle. The pooler username is
# always "<role>.<project-ref>", not just "<role>".
DATABASE_URL=postgresql://webhook_writer.your-project-ref:CHANGE_ME@aws-N-your-region.pooler.supabase.com:5432/postgres

# --- Supabase Storage (photo uploads) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=CHANGE_ME
STORAGE_BUCKET=ef-photos

# --- ArcGIS Online ---
ARCGIS_ORG_ID=E0EowMpDSIln8rmj
ARCGIS_CLIENT_ID=CHANGE_ME
ARCGIS_CLIENT_SECRET=CHANGE_ME
# Base URL of the hosted feature service behind the efish_neps_v8 form (item 8533e51b881b43b4b7281ff5753d42e2)
AGOL_FEATURE_SERVICE_URL=https://services.arcgis.com/CHANGE_ME/arcgis/rest/services/efish_neps_v8/FeatureServer

# --- Webhook security ---
# Shared secret configured on the ArcGIS Online webhook; used to verify the signature header.
WEBHOOK_SHARED_SECRET=CHANGE_ME

ENVIRONMENT=development
